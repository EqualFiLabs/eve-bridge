{
  "name": "@equalfilabs/eve-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "LayerZero V2 bridge for canonical EVE on Base",
  "license": "BUSL-1.1",
  "scripts": {
    "compile": "concurrently -c auto --names forge,hardhat '$npm_execpath run compile:forge' '$npm_execpath run compile:hardhat'",
    "compile:forge": "forge build",
    "compile:hardhat": "hardhat compile",
    "lint": "$npm_execpath run lint:js && $npm_execpath run lint:sol",
    "lint:fix": "eslint --fix '**/*.{js,ts,json}' && prettier --write . && solhint 'contracts/**/*.sol' --fix --noPrompt",
    "lint:js": "eslint '**/*.{js,ts,json}' && prettier --check .",
    "lint:sol": "solhint 'contracts/**/*.sol'",
    "typecheck": "tsc --noEmit",
    "test": "$npm_execpath run test:forge && $npm_execpath run test:hardhat",
    "test:forge": "forge test",
    "test:hardhat": "hardhat test",
    "verify": "$npm_execpath run lint && $npm_execpath run typecheck && $npm_execpath run compile && $npm_execpath run test"
  },
  "resolutions": {
    "ethers": "5.8.0",
    "hardhat-deploy": "0.12.4"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@layerzerolabs/devtools-evm-hardhat": "4.0.4",
    "@layerzerolabs/eslint-config-next": "2.3.44",
    "@layerzerolabs/io-devtools": "0.3.2",
    "@layerzerolabs/lz-definitions": "3.1.7",
    "@layerzerolabs/lz-evm-messagelib-v2": "3.0.168",
    "@layerzerolabs/lz-evm-protocol-v2": "3.0.168",
    "@layerzerolabs/lz-evm-v1-0.7": "3.0.168",
    "@layerzerolabs/lz-v2-utilities": "3.0.168",
    "@layerzerolabs/metadata-tools": "4.0.0",
    "@layerzerolabs/oapp-evm": "0.4.1",
    "@layerzerolabs/oft-evm": "4.0.1",
    "@layerzerolabs/prettier-config-next": "2.3.44",
    "@layerzerolabs/solhint-config": "3.0.168",
    "@layerzerolabs/test-devtools-evm-foundry": "8.0.1",
    "@layerzerolabs/toolbox-foundry": "0.1.13",
    "@layerzerolabs/toolbox-hardhat": "0.6.14",
    "@nomicfoundation/hardhat-ethers": "3.1.3",
    "@nomiclabs/hardhat-ethers": "2.2.3",
    "@openzeppelin/contracts": "5.6.1",
    "@openzeppelin/contracts-upgradeable": "5.6.1",
    "@rushstack/eslint-patch": "1.16.1",
    "@safe-global/safe-core-sdk-types": "2.3.0",
    "@types/chai": "4.3.20",
    "@types/mocha": "10.0.10",
    "@types/node": "18.18.14",
    "chai": "4.5.0",
    "concurrently": "9.1.2",
    "dotenv": "16.6.1",
    "eslint": "8.57.1",
    "eslint-plugin-jest-extended": "2.0.3",
    "ethers": "5.8.0",
    "hardhat": "2.29.0",
    "hardhat-contract-sizer": "2.10.1",
    "hardhat-deploy": "0.12.4",
    "mocha": "10.8.2",
    "prettier": "3.9.6",
    "solhint": "4.5.4",
    "solidity-bytes-utils": "0.8.4",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=18.16.0"
  },
  "pnpm": {
    "overrides": {
      "ethers": "5.8.0",
      "hardhat-deploy": "0.12.4"
    }
  },
  "overrides": {
    "ethers": "5.8.0",
    "hardhat-deploy": "0.12.4"
  }
